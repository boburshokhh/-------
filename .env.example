# ── Gemini API ────────────────────────────────────────────────────────────
GEMINI_API_KEY=your-gemini-api-key-here
LLM_MODEL=gemini-2.5-flash-lite

# ── Server ────────────────────────────────────────────────────────────────
PORT=3002
HOST_PORT=80
# Docker: порт на хосте → контейнер app:3002 (прямой доступ к Node). Основной вход — nginx на HOST_PORT.
APP_HOST_PORT=3002
MAX_FILE_SIZE_MB=10

# ── Chunking ──────────────────────────────────────────────────────────────
CHUNK_TOKEN_LIMIT=2500
CHUNK_OVERLAP_TOKENS=200

# ── PostgreSQL ────────────────────────────────────────────────────────────
DB_CLIENT=postgres
PGHOST=localhost
PGPORT=5432
PGDATABASE=ai_testgen
PGUSER=ai_testgen
PGPASSWORD=your-pg-password
# Docker Compose: пароль для контейнеров postgres и app (должен совпадать с первым созданием тома)
POSTGRES_PASSWORD=your-pg-password
# DATABASE_URL=postgresql://ai_testgen:password@localhost:5432/ai_testgen
# В compose DATABASE_URL сбрасывается; PGUSER в контейнере app всегда ai_testgen.

# ── MinIO / Object Storage ───────────────────────────────────────────────
# STORAGE_BACKEND=minio
# MINIO_ENDPOINT=localhost
# MINIO_PORT=9000
# MINIO_USE_SSL=false
# MINIO_ACCESS_KEY=
# MINIO_SECRET_KEY=
# MINIO_BUCKET=ai-testgen-docs

# ── RAG / Generation (опционально) ──────────────────────────────────────
# TARGET_QUESTIONS_MIN=20
# TARGET_QUESTIONS_MAX=30
# EMBEDDING_MODEL=gemini-embedding-001
# RAG_TOP_K=5
# ENABLE_GROUNDING=true
# DEDUP_THRESHOLD=0.88
# BACKFILL_MAX_ROUNDS=3

# ── Security (опционально) ──────────────────────────────────────────────
# CORS_ORIGINS=https://your-domain.com
# LOGS_API_TOKEN=
# SETTINGS_API_TOKEN=
