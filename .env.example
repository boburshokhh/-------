# ── Gemini API ────────────────────────────────────────────────────────────
GEMINI_API_KEY=your-gemini-api-key-here
LLM_MODEL=gemini-2.5-flash-lite

# ── Server ────────────────────────────────────────────────────────────────
PORT=3000
HOST_PORT=80
MAX_FILE_SIZE_MB=10

# ── Chunking ──────────────────────────────────────────────────────────────
CHUNK_TOKEN_LIMIT=2500
CHUNK_OVERLAP_TOKENS=200

# ── PostgreSQL ────────────────────────────────────────────────────────────
DB_CLIENT=postgres
PGHOST=localhost
PGPORT=5432
PGDATABASE=ai_testgen
PGUSER=bobur
PGPASSWORD=1602boburatg
# DATABASE_URL=postgresql://ai_testgen:password@localhost:5432/ai_testgen
# Docker Compose: в compose задано PGHOST=postgres и те же PGUSER/PGPASSWORD/PGDATABASE —
# контейнер postgres создаёт БД при первом запуске; порты 5432 на хост не пробрасываются.

# ── MinIO / Object Storage ───────────────────────────────────────────────
STORAGE_BACKEND=minio   # 'local' (по умолчанию) или 'minio'
MINIO_ENDPOINT=http://192.168.32.100
MINIO_PORT=9000
MINIO_USE_SSL=false
MINIO_ACCESS_KEY=admin
MINIO_SECRET_KEY=1602atgbobur
MINIO_BUCKET=ai-testgen-docs
# ── RAG / Generation (опционально) ──────────────────────────────────────
# TARGET_QUESTIONS_MIN=20
# TARGET_QUESTIONS_MAX=30
# EMBEDDING_MODEL=gemini-embedding-001
# RAG_TOP_K=5
# ENABLE_GROUNDING=true
# DEDUP_THRESHOLD=0.88
# BACKFILL_MAX_ROUNDS=3

# ── Security (опционально) ──────────────────────────────────────────────
# CORS_ORIGINS=https://your-domain.com
# LOGS_API_TOKEN=
# SETTINGS_API_TOKEN=
