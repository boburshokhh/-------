# ═══════════════════════════════════════════════════════════════════════════
# 1. Google Gemini
# ═══════════════════════════════════════════════════════════════════════════
GEMINI_API_KEY=your-gemini-api-key-here
LLM_MODEL=gemini-2.5-flash-lite
EMBEDDING_MODEL=gemini-embedding-001

# ═══════════════════════════════════════════════════════════════════════════
# 2. Лимиты и чанки
# ═══════════════════════════════════════════════════════════════════════════
MAX_FILE_SIZE_MB=10
CHUNK_TOKEN_LIMIT=2500
CHUNK_OVERLAP_TOKENS=200

# ═══════════════════════════════════════════════════════════════════════════
# 3. Порты (Docker)
#    HOST_PORT — nginx (http://сервер/). APP_HOST_PORT — прямой Node (http://сервер:3002/).
# ═══════════════════════════════════════════════════════════════════════════
PORT=3002
HOST_PORT=80
APP_HOST_PORT=3002

# ═══════════════════════════════════════════════════════════════════════════
# 4. PostgreSQL
#    Docker: пароль БД — POSTGRES_PASSWORD; в контейнере app пользователь всегда ai_testgen.
# ═══════════════════════════════════════════════════════════════════════════
DB_CLIENT=postgres
PGHOST=localhost
PGPORT=5432
PGDATABASE=ai_testgen
PGUSER=ai_testgen
PGPASSWORD=your-pg-password
POSTGRES_PASSWORD=your-pg-password
# Проброс Postgres на хост для DataGrip/внешних клиентов (docker compose). По умолчанию 5433 — см. docker-compose.yml
# POSTGRES_HOST_PORT=5433
# DATABASE_URL=postgresql://ai_testgen:password@localhost:5432/ai_testgen

# ═══════════════════════════════════════════════════════════════════════════
# 5. MinIO — endpoint без http://; порт отдельно (MINIO_PORT)
#    На том же хосте, что Docker: host.docker.internal
# ═══════════════════════════════════════════════════════════════════════════
# STORAGE_BACKEND=minio
# MINIO_ENDPOINT=host.docker.internal
# MINIO_PORT=9000
# MINIO_USE_SSL=false
# MINIO_ACCESS_KEY=
# MINIO_SECRET_KEY=
# MINIO_BUCKET=ai-testgen-docs

# ═══════════════════════════════════════════════════════════════════════════
# 6. Прочее (опционально)
# ═══════════════════════════════════════════════════════════════════════════
# CORS_ORIGINS=https://your-domain.com
# LOGS_API_TOKEN=
# SETTINGS_API_TOKEN=
