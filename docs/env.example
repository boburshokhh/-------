# Скопируйте:  cp docs/env.example .env

GEMINI_API_KEY=your-gemini-api-key-here
POSTGRES_PASSWORD=change-me-strong-password
PGDATABASE=ai_testgen

# Модели (не используйте gemini-2.0-* — 404 на новых ключах)
LLM_MODEL=gemini-2.5-flash-lite
LLM_FAST_MODEL=gemini-2.5-flash-lite
EMBEDDING_MODEL=gemini-embedding-001
SUMMARY_CHEAP_MODEL=gemini-2.5-flash-lite

LOCAL_GEMINI_QUOTA_ENABLED=false
GEMINI_REQUEST_TIMEOUT_MS=180000

ENABLE_GROUNDING=true
BACKFILL_MAX_ROUNDS=3
DEDUP_THRESHOLD=0.85
SUMMARY_MODE=cheap_llm
DEFAULT_DOCUMENT_LANGUAGE=ru

TARGET_QUESTIONS_MIN=20
TARGET_QUESTIONS_MAX=30
LLM_BATCH_SIZE=4

ENABLE_PDF_OCR=true
# Загрузка: max 100 стр. и 100 МБ — backend/utils/uploadLimits.js

# false — генерация в процессе upload (без worker). true — BullMQ + docker compose --profile queue
JOB_QUEUE_ENABLED=false
SSE_ENABLED=true
LLM_BATCH_PARALLELISM=4
BLUEPRINT_CACHE_ENABLED=true
EMBEDDING_CACHE_ENABLED=true
BULK_INSERT_ENABLED=true
CACHE_SCHEMA_VERSION=1

REDIS_HOST=redis
REDIS_PORT=6379
WORKER_CONCURRENCY=1

PORT=3002
HOST_PORT=80
APP_HOST_PORT=3002

STORAGE_BACKEND=local
AI_TESTGEN_DOCKER_NETWORK=edu_atg_ai_testgen_default
