# Скопируйте:  cp docs/env.example .env
# Оптимальные значения для качества + скорости + меньше ошибок

GEMINI_API_KEY=your-gemini-api-key-here
POSTGRES_PASSWORD=change-me-strong-password
PGDATABASE=ai_testgen

# Качество
ENABLE_GROUNDING=true
BACKFILL_MAX_ROUNDS=3
DEDUP_THRESHOLD=0.85
SUMMARY_MODE=cheap_llm

# Скорость (включено по умолчанию в production-шаблоне)
JOB_QUEUE_ENABLED=true
LLM_BATCH_PARALLELISM=4
BLUEPRINT_CACHE_ENABLED=true
EMBEDDING_CACHE_ENABLED=true
BULK_INSERT_ENABLED=true
SSE_ENABLED=true
CACHE_SCHEMA_VERSION=1

LOCAL_GEMINI_QUOTA_ENABLED=true
GEMINI_REQUEST_TIMEOUT_MS=180000

REDIS_HOST=redis
REDIS_PORT=6379
WORKER_CONCURRENCY=1

PORT=3002
HOST_PORT=80
APP_HOST_PORT=3002
